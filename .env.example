APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Configure either an asymmetric JWT key endpoint or the legacy symmetric secret.
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
# Exclusiva del backend/Render. Nunca usar ni publicar en Vercel.
SUPABASE_SERVICE_ROLE_KEY=
DOCUMENTS_BUCKET=erp-documents
MAX_DOCUMENT_SIZE_BYTES=10485760
CORS_ORIGINS=http://localhost:5173
