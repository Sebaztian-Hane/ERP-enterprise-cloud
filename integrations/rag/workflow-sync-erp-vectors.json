    {"parameters":{"httpMethod":"POST","path":"erp-rag-sync","responseMode":"lastNode","options":{"rawBody":true}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,180],"id":"0c02e8ca-91b5-48d6-9574-29f34c002001","name":"Webhook de cambios ERP","webhookId":"erp-rag-sync"},
