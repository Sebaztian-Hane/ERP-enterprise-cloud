{
    "name": "Sincronizar ERP a Supabase Vector (sin variables VPS)",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "erp-rag-sync",
                "responseMode": "lastNode",
                "options": {
                    "rawBody": true
                }
            },
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2.1,
            "position": [
                0,
                180
            ],
            "id": "0c02e8ca-91b5-48d6-9574-29f34c002001",
            "name": "Webhook de cambios ERP",
            "webhookId": "erp-rag-sync"
        },
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "hours",
                            "hoursInterval": 1
                        }
                    ]
                }
            },
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                0,
                340
            ],
            "id": "0c02e8ca-91b5-48d6-9574-29f34c002002",
            "name": "Respaldo cada hora"
        },
        {
            "parameters": {},
            "type": "n8n-nodes-base.manualTrigger",
            "typeVersion": 1,
            "position": [
                0,
                500
            ],
            "id": "0c02e8ca-91b5-48d6-9574-29f34c002003",
            "name": "Carga inicial manual"
        },
        {
            "parameters": {
        "jsCode": "// Los disparadores Manual y Schedule pueden entregar un objeto con headers vacío.\n// Solo el Webhook contiene la propiedad body: así no se confunde una carga inicial\n// con un evento incompleto.\nconst isWebhook = Object.prototype.hasOwnProperty.call($json, 'body');\nif (!isWebhook) return [{ json: { tenant_id: null, trigger: 'scheduled' } }];\n// Modo temporal sin variables del VPS. El ERP emite el evento después del\n// commit; activa HMAC cuando el secreto compartido esté disponible.\nif (!$json.body?.tenant_id) throw new Error('Evento sin tenant_id');\nreturn [{json:{tenant_id:$json.body.tenant_id,trigger:'event'}}];"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                240,
                300
            ],
            "id": "0c02e8ca-91b5-48d6-9574-29f34c002004",
            "name": "Validar evento temporal"
        },
        {
            "parameters": {
                "url": "https://erp-enterprisecloud-api.onrender.com/api/v1/rag/tenants",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "options": {}
            },
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                480,
                300
            ],
            "id": "0c02e8ca-91b5-48d6-9574-29f34c002005",
            "name": "Listar empresas ERP"
        },
        {
            "parameters": {
                "jsCode": "const requested = $('Validar evento temporal').first().json.tenant_id;\nif (requested) return [{json:{tenant_id:requested}}];\nreturn ($json.tenants || []).map((tenant) => ({json:{tenant_id:tenant.id}}));"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                720,
                300
            ],
            "id": "0c02e8ca-91b5-48d6-9574-29f34c002006",
            "name": "Determinar empresas a sincronizar"
        },
        {
            "parameters": {
                "url": "={{ 'https://erp-enterprisecloud-api.onrender.com/api/v1/rag/export?tenant_id=' + $json.tenant_id }}",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "options": {}
            },
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                960,
                300
            ],
            "id": "0c02e8ca-91b5-48d6-9574-29f34c002007",
            "name": "Exportar datos seguros del ERP"
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://zxkbupniddyysqbbkwkz.supabase.co/rest/v1/rpc/delete_erp_tenant_documents",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "supabaseApi",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ p_tenant_id: $json.tenant_id }) }}",
                "options": {}
            },
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1200,
                300
            ],
            "id": "0c02e8ca-91b5-48d6-9574-29f34c002008",
            "name": "Limpiar vectores previos de la empresa"
        },
        {
            "parameters": {
                "jsCode": "const exported = $('Exportar datos seguros del ERP').item.json;\nreturn (exported.documents || []).map((doc) => ({json:{content:doc.content,tenant_id:doc.tenant_id,source:doc.source,source_id:doc.id,title:doc.title,updated_at:doc.updated_at,metadata:doc.metadata || {}}}));"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1440,
                300
            ],
            "id": "0c02e8ca-91b5-48d6-9574-29f34c002009",
            "name": "Preparar documentos ERP para RAG"
        },
        {
            "parameters": {
                "batchSize": 1,
                "options": {}
            },
            "type": "n8n-nodes-base.splitInBatches",
            "typeVersion": 3,
            "position": [
                1620,
                300
            ],
            "id": "0c02e8ca-91b5-48d6-9574-29f34c002014",
            "name": "Procesar un documento a la vez"
        },
        {
            "parameters": {
                "mode": "insert",
                "tableName": {
                    "__rl": true,
                    "value": "documents",
                    "mode": "list",
                    "cachedResultName": "documents"
                },
                "embeddingBatchSize": 1,
                "options": {
                    "queryName": "match_documents"
                }
            },
            "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
            "typeVersion": 1.3,
            "alwaysOutputData": true,
            "position": [
                1840,
                300
            ],
            "id": "0c02e8ca-91b5-48d6-9574-29f34c002010",
            "name": "Supabase Vector Store"
        },
        {
            "parameters": {
                "modelName": "models/gemini-embedding-2"
            },
            "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
            "typeVersion": 1,
            "position": [
                1520,
                620
            ],
            "id": "0c02e8ca-91b5-48d6-9574-29f34c002011",
            "name": "Embeddings Google Gemini"
        },
        {
            "parameters": {
                "jsonMode": "expressionData",
                "jsonData": "={{ $json.content }}",
                "textSplittingMode": "custom",
                "options": {
                    "metadata": {
                        "metadataValues": [
                            {
                                "name": "tenant_id",
                                "value": "={{ $json.tenant_id }}"
                            },
                            {
                                "name": "source",
                                "value": "={{ $json.source }}"
                            },
                            {
                                "name": "source_id",
                                "value": "={{ $json.source_id }}"
                            },
                            {
                                "name": "title",
                                "value": "={{ $json.title }}"
                            },
                            {
                                "name": "updated_at",
                                "value": "={{ $json.updated_at }}"
                            }
                        ]
                    }
                }
            },
            "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
            "typeVersion": 1.1,
            "position": [
                1760,
                620
            ],
            "id": "0c02e8ca-91b5-48d6-9574-29f34c002012",
            "name": "Cargador de documentos ERP"
        },
        {
            "parameters": {
                "chunkSize": 1800,
                "chunkOverlap": 180,
                "options": {}
            },
