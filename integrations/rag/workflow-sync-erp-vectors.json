    {"parameters":{},"type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[0,500],"id":"0c02e8ca-91b5-48d6-9574-29f34c002003","name":"Carga inicial manual"},
    {"parameters":{"jsCode":"const isWebhook = Boolean($json.headers);\nif (!isWebhook) return [{ json: { tenant_id: null, trigger: 'scheduled' } }];\nconst crypto = require('crypto'); const timestamp = $json.headers['x-erp-timestamp']; const received = $json.headers['x-erp-signature'];\nconst raw = $json.rawBody || JSON.stringify($json.body || {});\nif (!timestamp || !received || Math.abs(Date.now()/1000 - Number(timestamp)) > 300) throw new Error('Webhook vencido o incompleto');\nconst expected = 'sha256=' + crypto.createHmac('sha256', $env.ERP_RAG_WEBHOOK_SECRET).update(`${timestamp}.${raw}`).digest('hex');\nconst a = Buffer.from(received); const b = Buffer.from(expected);\nif (a.length !== b.length || !crypto.timingSafeEqual(a,b)) throw new Error('Firma HMAC inválida');\nif (!$json.body?.tenant_id) throw new Error('Evento sin tenant_id');\nreturn [{json:{tenant_id:$json.body.tenant_id,trigger:'event'}}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[240,300],"id":"0c02e8ca-91b5-48d6-9574-29f34c002004","name":"Validar evento ERP"},
    {"parameters":{"url":"={{ $env.ERP_API_URL + '/rag/tenants' }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"X-RAG-Integration-Key","value":"={{ $env.ERP_RAG_INTEGRATION_KEY }}"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[480,300],"id":"0c02e8ca-91b5-48d6-9574-29f34c002005","name":"Listar empresas ERP"},
    {"parameters":{"jsCode":"const requested = $('Validar evento ERP').first().json.tenant_id;\nif (requested) return [{json:{tenant_id:requested}}];\nreturn ($json.tenants || []).map((tenant) => ({json:{tenant_id:tenant.id}}));"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[720,300],"id":"0c02e8ca-91b5-48d6-9574-29f34c002006","name":"Determinar empresas a sincronizar"},
    {"parameters":{"url":"={{ $env.ERP_API_URL + '/rag/export?tenant_id=' + $json.tenant_id }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"X-RAG-Integration-Key","value":"={{ $env.ERP_RAG_INTEGRATION_KEY }}"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[960,300],"id":"0c02e8ca-91b5-48d6-9574-29f34c002007","name":"Exportar datos seguros del ERP"},
    {"parameters":{"method":"POST","url":"={{ $env.SUPABASE_RAG_URL + '/rest/v1/rpc/delete_erp_tenant_documents' }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"={{ $env.SUPABASE_RAG_SERVICE_ROLE_KEY }}"},{"name":"Authorization","value":"={{ 'Bearer ' + $env.SUPABASE_RAG_SERVICE_ROLE_KEY }}"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ p_tenant_id: $json.tenant_id }) }}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1200,300],"id":"0c02e8ca-91b5-48d6-9574-29f34c002008","name":"Limpiar vectores previos de la empresa"},
    {"parameters":{"jsCode":"const exported = $('Exportar datos seguros del ERP').item.json;\nreturn (exported.documents || []).map((doc) => ({json:{content:doc.content,tenant_id:doc.tenant_id,source:doc.source,source_id:doc.id,title:doc.title,updated_at:doc.updated_at,metadata:doc.metadata || {}}}));"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1440,300],"id":"0c02e8ca-91b5-48d6-9574-29f34c002009","name":"Preparar documentos ERP para RAG"},
    {"parameters":{"batchSize":1,"options":{}},"type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[1620,300],"id":"0c02e8ca-91b5-48d6-9574-29f34c002014","name":"Procesar un documento a la vez"},
